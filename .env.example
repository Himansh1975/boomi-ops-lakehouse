# Only needed for live mode. Replay mode needs nothing.
# Create the token in Boomi: Settings > Account Information and Setup > Platform API Tokens.
BOOMI_ACCOUNT_ID=
BOOMI_USERNAME=
BOOMI_API_TOKEN=
# North America default. Europe: https://api.platform.gb.boomi.com/api/rest/v1
BOOMI_BASE_URL=https://api.boomi.com/api/rest/v1

# Where landing files and Delta tables go. Local path, or a Unity Catalog Volume path on Databricks.
DATA_ROOT=data
